# ZeroAlloc.Analyzers: surface every rule as a warning in the library (src only).
[*.cs]
# ZA0101 (FrozenDictionary) was tried on IndexSegment.ExactPostings and not adopted: with 1M documents it raised the
# managed heap by about 20% (70 to 84 MB) and the time of a merge by about 40%, and query latencies stayed within the
# noise of the measurement, while a snapshot of many small segments builds one dictionary per change.
dotnet_diagnostic.ZA0101.severity = suggestion
dotnet_diagnostic.ZA0102.severity = warning
dotnet_diagnostic.ZA0103.severity = warning
dotnet_diagnostic.ZA0104.severity = warning
dotnet_diagnostic.ZA0105.severity = warning
