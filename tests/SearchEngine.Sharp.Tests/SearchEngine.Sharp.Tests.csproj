<Project Sdk="Microsoft.NET.Sdk">

  <!-- TUnit is a self-hosting Microsoft.Testing.Platform application: the project builds an executable and needs neither
       Microsoft.NET.Test.Sdk nor a VSTest adapter. global.json at the repository root opts dotnet test into the platform:
       "dotnet test" with the project option, from the repository root (see README.md). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- A TUnit analyzer warning (an assertion that is not awaited, a blocking wait in a test) fails the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.87.12" />
    <!-- CollectionOrdering, used for ordered sequence checks: IsEquivalentTo(expected, CollectionOrdering.Matching). -->
    <Using Include="TUnit.Assertions.Enums" />
  </ItemGroup>

  <!-- Files still written for xunit while the suite moves to TUnit; each is removed from this list when converted. -->
  <ItemGroup>
    <Compile Remove="ProgressiveIndexIngestionTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SearchEngine.Sharp\SearchEngine.Sharp.csproj" />
  </ItemGroup>

</Project>
